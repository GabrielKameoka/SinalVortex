# Reference only: .NET does not automatically load this file.
# Configure these separately in Railway API / Worker variables or local user-secrets.
# Never copy backend secrets to the Angular frontend.

# API only: generate a random secret (at least 32 bytes).
Jwt__SigningKey=
# API and Worker: use the same PostgreSQL database and Redis instance.
ConnectionStrings__DefaultConnection=
ConnectionStrings__RedisConnection=

# API only: public frontend origin, not the API URL; no trailing slash.
Cors__AllowedOrigins__0=https://sinal-vortex.vercel.app

# Worker only: required for actual email delivery.
EmailSettings__SmtpHost=
EmailSettings__SmtpPort=587
EmailSettings__EnableSsl=true
EmailSettings__From=
EmailSettings__Username=
EmailSettings__Password=

# Worker: set only when enabling outgoing webhooks to a trusted HTTPS origin.
# WebhookSettings__AllowedOrigins__0=https://your-receiver.example

# API: enable signature verification and configure a secret for EACH inbound provider.
# Replace PROVIDER with the exact route provider name before use.
# Webhooks__ValidarAssinatura=true
# Webhooks__PROVIDER__Secret=
